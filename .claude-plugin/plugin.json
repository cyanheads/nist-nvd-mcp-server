{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "nist-nvd-mcp-server",
  "version": "0.3.2",
  "description": "Search and audit CVEs by keyword, severity, CWE, CISA KEV status, and CPE via the NIST National Vulnerability Database. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/nist-nvd-mcp-server#readme",
  "repository": "https://github.com/cyanheads/nist-nvd-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "nist",
    "nvd",
    "cve",
    "cpe",
    "vulnerability",
    "security",
    "cvss"
  ],
  "userConfig": {
    "NVD_API_KEY": {
      "type": "string",
      "title": "NVD API key",
      "description": "Optional. Without a key the NVD rate limit is 5 requests per 30 seconds; with one, 50. Get one free at nvd.nist.gov/developers/request-an-api-key.",
      "sensitive": true,
      "default": ""
    }
  },
  "mcpServers": {
    "nist-nvd-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/nist-nvd-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "NVD_API_KEY": "${user_config.NVD_API_KEY}"
      }
    }
  }
}
